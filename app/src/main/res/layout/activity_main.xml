<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/button_toast"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:textAllCaps="true"
        android:onClick="show_toast"
        android:text="@string/toast"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_zero"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:backgroundTint="#888888"
        android:textColor="#FFFFFF"
        android:text="ZERO"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="@id/button_toast"
        app:layout_constraintTop_toBottomOf="@id/button_toast"
        app:layout_constraintBottom_toTopOf="@id/button_count" />

    <Button
        android:id="@+id/button_count"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#0000FF"
        android:textColor="#FFFFFF"
        android:textAllCaps="true"
        android:onClick="increase_count"
        android:text="@string/count"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="@id/button_toast"
        app:layout_constraintBottom_toBottomOf="@id/text_display_count" />

    <TextView
        android:id="@+id/text_display_count"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="#FFEB3B"
        android:gravity="center"
        android:text="@string/count_value"
        android:textColor="#3F51B5"
        android:textSize="150sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/button_toast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_toast" />

</androidx.constraintlayout.widget.ConstraintLayout>
